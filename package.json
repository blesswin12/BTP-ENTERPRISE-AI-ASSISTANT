{
  "name": "enterprise-ai-assistant",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
