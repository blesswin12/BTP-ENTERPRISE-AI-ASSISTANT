{
  "name": "enterprise-ai-assistant",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/attachments": "^3.13.3",
    "@cap-js/audit-logging": "^1.2.2",
    "@cap-js/hana": "^2",
    "@cap-js/notifications": "^0.3.0",
    "@cap-js/postgres": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sap-cloud-sdk/http-client": "^3.26.0",
    "@sap-cloud-sdk/resilience": "^3.26.0",
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^1",
    "@sap/xsenv": "^6.2.1",
    "@sap/xssec": "^4",
    "axios": "^1.18.1",
    "cf-nodejs-logging-support": "^8.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "better-sqlite3": "^12.11.1",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "watch:mtx": "CDS_ENV=mtx env -u NODE_PATH node ./node_modules/@sap/cds-dk/bin/cds.js watch --profile mtx",
    "start": "cds-serve",
    "mcp:start": "node mcp/server.js",
    "watch-purchaseorders": "cds watch --open enterprise.ai.purchaseorders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy enterprise-ai-assistant --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rm -rf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "test": "npx cds test",
    "test:watch": "npx cds test --watch",
    "test:silent": "npx cds test --silent"
  },
  "private": true,
  "cds": {
    "requires": {
      "audit-log": {
        "kind": "audit-log-to-console"
      },
      "messaging": {
        "[production]": {
          "kind": "enterprise-messaging-shared",
          "format": "cloudevents"
        },
        "[development]": {
          "kind": "file-based-messaging"
        }
      },
      "toggles": true,
      "extensibility": true,
      "auth": "mocked",
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      },
      "destinations": true,
      "html5-repo": true,
      "notifications": {
        "types": "srv/notification-types.json",
        "outboxed": true
      },
      "credstore": {
        "kind": "rest"
      },
      "attachments": {
        "outboxed": true
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/purchaseorders"
  ]
}
