# ==============================================================================
# Enterprise AI Assistant - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq AI Configuration (Required for Chat, Analytics, and Executive Summary)
# ------------------------------------------------------------------------------
# Your Groq API Key (get one from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq API endpoint (defaults to standard OpenAI-compatible Groq completions URL)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Model to use on Groq (e.g., openai/gpt-oss-120b, llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 2. Embedding Configuration (Optional - RAG Document Search)
# Note: Document search in askDocument uses database keyword search by default.
# If you wish to use an external embedding service (e.g. OpenAI), configure below:
# ------------------------------------------------------------------------------
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# OPENAI_API_KEY=your_openai_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 3. MCP (Model Context Protocol) Server & App Configuration
# ------------------------------------------------------------------------------
# MCP Server Port (MCP runs on port 3001, CAP on 4004)
MCP_PORT=3001

# URL of the MCP server when connecting from clients or CAP
MCP_SERVER_URL=http://localhost:3001/mcp

# ------------------------------------------------------------------------------
# 4. SAP CAP Environment Profiles (Optional)
# ------------------------------------------------------------------------------
# Set to 'development' for local testing (default)
# CDS_ENV=development
