{
  "welcomeFile": "/enterpriseaipurchaseorders/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/mcp(.*)$",
      "target": "/mcp$1",
      "destination": "mcp-api",
      "csrfProtection": false,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/chat/(.*)$",
      "target": "/chat/$1",
      "destination": "srv-api",
      "csrfProtection": false,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "csrfProtection": true
    }
  ]
}