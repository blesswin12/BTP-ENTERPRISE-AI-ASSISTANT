# ─────────────────────────────────────────
# DOCUMENTS
# ─────────────────────────────────────────

### Get all uploaded documents
GET {{baseUrl}}/chat/Documents
Accept: application/json

###

# ─────────────────────────────────────────
# CHAT HISTORY
# ─────────────────────────────────────────

### Get all chat history
GET {{baseUrl}}/chat/ChatHistory
Accept: application/json

###

### Get last 5 chat history entries
GET {{baseUrl}}/chat/ChatHistory?$orderby=timestamp desc&$top=5
Accept: application/json

###

### Filter chat history by feature
GET {{baseUrl}}/chat/ChatHistory?$filter=feature eq 'Analytics'
Accept: application/json

###

# ─────────────────────────────────────────
# ODATA METADATA
# ─────────────────────────────────────────

### Get OData metadata
GET {{baseUrl}}/chat/$metadata
Accept: application/xml

###

### Get service document
GET {{baseUrl}}/chat/
Accept: application/json