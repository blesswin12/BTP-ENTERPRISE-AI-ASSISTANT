### Enterprise AI Assistant — ProcureAI API Tests
### Base URL
@baseUrl = https://port4004-workspaces-ws-ok3n6.us10.trial.applicationstudio.cloud.sap

# ─────────────────────────────────────────
# PURCHASE ORDERS
# ─────────────────────────────────────────

### Get all Purchase Orders
GET {{baseUrl}}/chat/PurchaseOrders
Accept: application/json

###

### Get PO with line items expanded
GET {{baseUrl}}/chat/PurchaseOrders?$expand=items
Accept: application/json

###

### Get single PO by UUID
GET {{baseUrl}}/chat/PurchaseOrders(f1000001-0000-0000-0000-000000000001)
Accept: application/json

###

### Filter POs by status
GET {{baseUrl}}/chat/PurchaseOrders?$filter=status eq 'Approved'
Accept: application/json

###

### Filter POs by supplier
GET {{baseUrl}}/chat/PurchaseOrders?$filter=contains(supplier,'Tata')
Accept: application/json

###

### Filter POs by date range
GET {{baseUrl}}/chat/PurchaseOrders?$filter=orderDate ge 2026-01-01 and orderDate le 2026-06-30
Accept: application/json

###

### Sort POs by totalAmount descending
GET {{baseUrl}}/chat/PurchaseOrders?$orderby=totalAmount desc
Accept: application/json

###

### Get top 3 POs
GET {{baseUrl}}/chat/PurchaseOrders?$top=3
Accept: application/json

###

### Create new Purchase Order
POST {{baseUrl}}/chat/PurchaseOrders
Content-Type: application/json

{
    "purchaseOrder": "PO-2001",
    "supplier": "Tata Steel Ltd",
    "buyer": "Ravi Kumar",
    "orderDate": "2026-07-01",
    "deliveryDate": "2026-08-01",
    "currency": "INR",
    "totalAmount": 250000
}

###

### Update PO status to Approved
PATCH {{baseUrl}}/chat/PurchaseOrders(f1000001-0000-0000-0000-000000000001)
Content-Type: application/json

{
    "status": "Approved"
}

###

### Delete a PO
DELETE {{baseUrl}}/chat/PurchaseOrders(f1000001-0000-0000-0000-000000000001)

###

# ─────────────────────────────────────────
# PURCHASE ORDER ITEMS
# ─────────────────────────────────────────

### Get all PO Items
GET {{baseUrl}}/chat/PurchaseOrderItems
Accept: application/json

###

### Get items for a specific PO
GET {{baseUrl}}/chat/PurchaseOrders(f1000001-0000-0000-0000-000000000001)/items
Accept: application/json

###

### Create new PO Item
POST {{baseUrl}}/chat/PurchaseOrderItems
Content-Type: application/json

{
    "purchaseOrder_ID": "f1000001-0000-0000-0000-000000000001",
    "itemNumber": 10,
    "material": "STEEL-003",
    "description": "Galvanized Steel Sheet",
    "quantity": 50,
    "unit": "KG",
    "netPrice": 2000.00,
    "netAmount": 100000.00,
    "plant": "Plant-Chennai",
    "deliveryDate": "2026-08-01"
}

